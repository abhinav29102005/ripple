# Ripple Runtime Configuration
LLM_MODE=off
PUBLIC_MODE=0
RANDOM_SEED=42
API_PORT=8000
API_HOST=0.0.0.0
WORKER_CONCURRENCY=4
LEASE_DURATION_SEC=30
RECLAIM_INTERVAL_SEC=5

# OpenAI-Compatible LLM Provider Configuration
# Set LLM_MODE=on to enable model-selected tools.
# Preset examples (uncomment one provider or configure your own):

# Groq preset:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_key_here
# LLM_MODEL=openai/gpt-oss-120b

# Mistral preset:
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=your_mistral_key_here
# LLM_MODEL=mistral-large-latest

# OpenRouter preset:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your_openrouter_key_here
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Local Ollama preset:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

LLM_BASE_URL=
