# Ripple Environment Configuration

# FalkorDB Connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# LLM Configuration
# Modes: "off" (deterministic template fallback) | "on" (uses LLM provider)
LLM_MODE=off
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Worker Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKER_CONCURRENCY=4
LEASE_DURATION_SEC=30
RECLAIM_INTERVAL_SEC=5

# Synthetic Data Seed
RANDOM_SEED=42

# Public Demo Mode (1 = disables destructive endpoints, rate-limits LLM/chat)
PUBLIC_MODE=0
